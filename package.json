{
  "name": "@fault/api-client",
  "version": "0.1.0",
  "description": "Client Node.js/TypeScript (Axios) pour contacter l'API FAULT sans passer par curl.",
  "type": "module",
  "main": "src/index.js",
  "files": [
    "src",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-version": "./scripts/check-version.sh",
    "security": "npx eslint . --max-warnings 0 --ignore-pattern './tests/*'"
  },
  "dependencies": {
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-security": "^4.1.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}