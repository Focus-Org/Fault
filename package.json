{
  "name": "@focus-labs/fault-client",
  "version": "0.1.3",
  "description": "Client Node.js/TypeScript (Axios) pour contacter l'API FAULT sans passer par curl.",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": { ".": { "types": "./index.d.ts", "default": "./index.js" } },
  "engines": { "node": ">=20.19" },
  "files": [
    "src",
    "index.js",
    "index.d.ts"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "check-version": "./scripts/check-version.sh",
    "security": "npx eslint . --max-warnings 0 --ignore-pattern './tests/*'"
  },
  "dependencies": {
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-security": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Focus-Org/Fault.git"
  },
  "bugs": {
    "url": "https://github.com/Focus-Org/Fault/issues"
  },
  "homepage": "https://github.com/Focus-Org/Fault#readme",
  "publishConfig": {
    "access": "public"
  }
}
